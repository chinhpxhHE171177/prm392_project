<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        android:background="@drawable/circle_background"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Name -->
    <TextView
        android:id="@+id/tvEmployeeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nguyễn Văn A"
        android:textSize="16sp"
        android:paddingStart="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:minWidth="100dp"
        app:layout_constraintTop_toTopOf="@id/imgAvatar"
        app:layout_constraintStart_toEndOf="@id/imgAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvEmployeeStatus" />

    <!-- Username -->
    <TextView
        android:id="@+id/tvEmployeeUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="nguyenvana"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tvEmployeeName"
        app:layout_constraintStart_toStartOf="@id/tvEmployeeName"
        app:layout_constraintEnd_toEndOf="@id/tvEmployeeName" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvEmployeeStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Đang hoạt động"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/tvEmployeeName"
        app:layout_constraintBottom_toBottomOf="@id/tvEmployeeName"
        app:layout_constraintStart_toEndOf="@id/tvEmployeeName"
        app:layout_constraintEnd_toStartOf="@+id/btnEdit" />

    <!-- Button Edit -->
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tvEmployeeStatus"
        app:layout_constraintBottom_toBottomOf="@id/tvEmployeeStatus"
        app:layout_constraintStart_toEndOf="@id/tvEmployeeStatus"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete" />

    <!-- Button Delete -->
    <Button
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btnEdit"
        app:layout_constraintBottom_toBottomOf="@id/btnEdit"
        app:layout_constraintStart_toEndOf="@id/btnEdit"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>