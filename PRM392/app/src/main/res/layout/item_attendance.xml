<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAttendanceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-07-17"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAttendanceCheckIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in: 08:00"
            android:textColor="#388E3C"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAttendanceCheckOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-out: 17:00"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvAttendanceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái: Đúng giờ"
            android:textColor="#FF9800"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_status_completed"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvAttendanceNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghi chú: ..."
            android:textColor="#757575"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>