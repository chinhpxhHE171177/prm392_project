<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Employee ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person"
                app:tint="#4CAF50"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etEmployeeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Employee ID"
                android:inputType="number"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:tint="#2196F3"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date (YYYY-MM-DD)"
                android:inputType="date"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Shift Start -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clock"
                app:tint="#F44336"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etShiftStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Shift Start (HH:mm:ss)"
                android:inputType="time"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Shift End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clock"
                app:tint="#F44336"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etShiftEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Shift End (HH:mm:ss)"
                android:inputType="time"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Break Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person_add"
                app:tint="#FF9800"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etBreakDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Break Duration (minutes)"
                android:inputType="number"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:layout_gravity="end"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingHorizontal="16dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>